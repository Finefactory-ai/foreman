# The settings for the container runner (runner/README.md): the ones Set up › Cloud runner
# writes into .env.runner from the keys saved on its other steps. For Docker Compose, copy
# that file to runner/foreman.env, which git ignores. Never commit a copy with values in it.

# The project, as owner/name, and its base branch.
FOREMAN_REPO=
FOREMAN_BRANCH=main

# GitHub: a classic token with the repo scope (add workflow if a story may change
# .github/workflows), or a fine-grained token for the project with Contents and Pull
# requests read and write, and Actions and Commit statuses read (add Workflows read and
# write for .github/workflows, and Deployments read for the deploy-github step, as needed).
# A fine-grained token can't read check runs, so Foreman waits on GitHub Actions jobs and
# commit statuses instead: a check that other apps post is not seen.
GH_TOKEN=

# One Claude sign-in. A Console API key, or a subscription token from `claude setup-token`
# (your own projects only). When both are set, the API key wins.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Needed because the dashboard listens beyond the container. Make it long and random,
# for example with `openssl rand -hex 24`.
FOREMAN_DASHBOARD_TOKEN=

# Optional: how many slots build at once, and how many stories to build before stopping
# (unset: the workers setting, and until stopped).
# FOREMAN_WORKERS=1
# FOREMAN_MAX=

# The project's own keys, named in cloud.envVars in its foreman.config.json.
# RESEND_API_KEY=
